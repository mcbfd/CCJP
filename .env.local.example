# =====================================================================
# CCJP — Variables d'environnement
#
# Copiez ce fichier en `.env.local` et renseignez les valeurs.
#   cp .env.local.example .env.local
#
# ⚠️  `.env.local` est ignoré par Git (.gitignore). Ne le committez JAMAIS.
# ⚠️  Seules les variables préfixées par NEXT_PUBLIC_ sont visibles dans le
#     navigateur. Ne mettez JAMAIS ce préfixe sur la clé service_role.
# =====================================================================

# ---------------------------------------------------------------------
# Supabase — à récupérer dans Dashboard Supabase → Settings → API
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://[votre-projet-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ CLÉ ULTRA-SENSIBLE — contourne toutes les politiques RLS.
#    Utilisée UNIQUEMENT côté serveur. Jamais dans un composant client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
# En local : http://localhost:3000
# En production : https://ccjp-podor.sn
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=CCJP - Conseil Consultatif des Jeunes de Podor

# ---------------------------------------------------------------------
# Revalidation du cache (webhook Supabase → Vercel)
# Secret partagé long et aléatoire, à générer avec :
#   openssl rand -base64 32
# ---------------------------------------------------------------------
REVALIDATE_SECRET=changez-moi-par-un-secret-long-et-aleatoire

# ---------------------------------------------------------------------
# Email transactionnel (optionnel — réservé à la Phase 2)
# Voir PLAN_IMPLEMENTATION.md §19
# ---------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# EMAIL_FROM=contact@ccjp-podor.sn

# ---------------------------------------------------------------------
# Identifiant du projet Supabase — utilisé par `npm run db:types`
# ---------------------------------------------------------------------
SUPABASE_PROJECT_ID=votre-projet-ref
